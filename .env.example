# Copy to .env locally / set in cPanel Node.js App env UI
NODE_ENV=production

# MySQL — buat database dulu (cPanel: MySQL Databases; lokal: Laragon phpMyAdmin)
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="mysql://root:@localhost:3306/javaorigins"

# Public
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_ADMIN_WA=6281234567890

# Admin (generate hash: node -e "require('bcryptjs').hash('YOUR_PASS',12).then(console.log)")
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD_HASH=

# Session HMAC (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Tabel dibuat otomatis saat app pertama kali jalan; produk/banner/metode bayar
# di-seed otomatis jika tabel kosong. Admin login tetap dari env di atas.
